{
  "name": "yul",
  "version": "0.0.11",
  "description": "Keeps dependencies current: blocks Qwen Code from writing outdated exact-pinned versions into manifests.",
  "format": "qwen",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/ensure-yul.sh", "timeout": 60000 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/session-scan.sh", "timeout": 60000 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hook.sh", "timeout": 30000 }
        ]
      }
    ]
  }
}
