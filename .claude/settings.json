{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$CLAUDE_PROJECT_DIR/yul\" ]; then exec \"$CLAUDE_PROJECT_DIR/yul\"; fi",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
