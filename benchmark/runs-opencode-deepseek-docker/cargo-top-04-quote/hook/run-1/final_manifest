[package]
name = "codegen-macro"
version = "0.1.0"
edition = "2021"
description = "A procedural-macro crate that generates Rust source code as a token stream"
license = "MIT OR Apache-2.0"

[lib]
proc-macro = true

[dependencies]
proc-macro2 = "1"
quote = "1"
syn = { version = "3", features = ["full", "extra-traits"] }
