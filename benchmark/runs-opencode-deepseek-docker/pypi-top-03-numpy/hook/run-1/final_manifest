[project]
name = "matrixlab"
version = "0.1.0"
description = "Heavy numerical array and matrix computations"
readme = "README.md"
authors = [
    { name = "benchmark", email = "benchmark@example.com" }
]
requires-python = ">=3.11"
dependencies = [
    "numpy>=2.4.6",
    "scipy>=1.17.1",
]

[project.scripts]
matrixlab = "matrixlab.main:main"

[build-system]
requires = ["uv_build>=0.12.19,<0.13.0"]
build-backend = "uv_build"

[dependency-groups]
dev = [
    "pytest>=9.1.1",
    "pytest-benchmark>=5.3.0",
]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-ra"
