[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "numerical"
version = "0.1.0"
description = "Heavy numerical array and matrix computations"
readme = "README.md"
requires-python = ">=3.10"
dependencies = [
    "numpy>=1.26",
    "scipy>=1.11",
]

[project.optional-dependencies]
dev = [
    "pytest>=7.4",
]

[project.scripts]
numerical = "numerical.__main__:main"

[tool.hatch.build.targets.wheel]
packages = ["src/numerical"]

[tool.pytest.ini_options]
testpaths = ["tests"]
