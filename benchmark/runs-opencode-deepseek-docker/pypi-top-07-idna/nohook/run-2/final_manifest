[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "idna-toolkit"
version = "0.1.0"
description = "Encode and decode internationalized domain names (IDNA 2008, RFC 5891)."
readme = "README.md"
requires-python = ">=3.9"
license = { text = "MIT" }
authors = [{ name = "idna-toolkit contributors" }]
keywords = ["idna", "idn", "punycode", "internationalized-domain-names"]
classifiers = [
    "Programming Language :: Python :: 3",
    "Topic :: Internet :: Name Service (DNS)",
]
dependencies = ["idna>=3.4"]

[project.scripts]
idna-toolkit = "idna_toolkit.cli:main"

[project.optional-dependencies]
dev = ["pytest>=7.0", "ruff>=0.1"]

[tool.hatch.build.targets.wheel]
packages = ["src/idna_toolkit"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q"

[tool.ruff]
line-length = 100
target-version = "py39"
