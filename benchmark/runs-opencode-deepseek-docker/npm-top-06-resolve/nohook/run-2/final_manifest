{
  "name": "node-module-resolver",
  "version": "0.1.0",
  "description": "Programmatic implementation of Node.js module resolution (require.resolve) for build tools.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "node-module-resolver": "bin/resolve.js"
  },
  "files": [
    "src",
    "bin"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "cli": "node bin/resolve.js"
  },
  "keywords": [
    "module",
    "resolution",
    "require.resolve",
    "resolve",
    "node_modules",
    "exports",
    "imports",
    "build-tool"
  ],
  "license": "MIT"
}
