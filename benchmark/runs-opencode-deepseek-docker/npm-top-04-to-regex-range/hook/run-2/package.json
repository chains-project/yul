{
  "name": "range-to-regex",
  "version": "1.0.0",
  "description": "Convert a numeric range like \"1-100\" into a single regular expression that matches any number in that range.",
  "type": "module",
  "main": "./src/range-to-regex.js",
  "bin": {
    "range-to-regex": "./src/cli.js"
  },
  "exports": {
    ".": "./src/range-to-regex.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "node --check src/range-to-regex.js && node --check src/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "regex",
    "regexp",
    "range",
    "number",
    "numeric-range"
  ],
  "license": "MIT"
}
