[project]
name = "https-verify"
version = "0.1.0"
description = "Fetch HTTPS resources using certifi's up-to-date root CA bundle"
requires-python = ">=3.9"
dependencies = [
    "certifi>=2024.7.4",
]

[project.scripts]
https-verify = "https_verify:main"

[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[tool.setuptools.packages.find]
where = ["src"]
