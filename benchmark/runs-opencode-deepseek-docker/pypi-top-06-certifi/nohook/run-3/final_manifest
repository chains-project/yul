[build-system]
requires = ["setuptools>=61"]
build-backend = "setuptools.build_meta"

[project]
name = "secure-https"
version = "0.1.0"
description = "HTTPS client that verifies servers against an up-to-date root CA bundle"
requires-python = ">=3.9"
dependencies = [
    "certifi>=2024.2.2",
]

[project.optional-dependencies]
dev = [
    "pytest>=8.0",
]

[project.scripts]
secure-https = "secure_https.cli:main"

[tool.setuptools.packages.find]
where = ["src"]

[tool.pytest.ini_options]
testpaths = ["tests"]
