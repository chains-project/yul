[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "https-verify"
version = "0.1.0"
description = "HTTPS client that verifies connections with an up-to-date CA bundle"
requires-python = ">=3.9"
dependencies = ["certifi>=2024.2.2"]

[project.optional-dependencies]
dev = ["pytest>=7"]

[project.scripts]
https-verify = "https_verify.__main__:main"

[tool.setuptools.packages.find]
where = ["src"]

[tool.pytest.ini_options]
testpaths = ["tests"]
