[build-system]
requires = ["setuptools==68.2.2"]
build-backend = "setuptools.build_meta"

[project]
name = "api-fetcher"
version = "0.1.0"
description = "Fetch data from a REST API over HTTP."
readme = "README.md"
requires-python = ">=3.9"
dependencies = ["requests==2.34.2"]

[project.optional-dependencies]
dev = ["pytest==9.1.1"]

[project.scripts]
api-fetcher = "api_fetcher.__main__:main"

[tool.setuptools.packages.find]
where = ["src"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q"
