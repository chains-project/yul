[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "notemgr"
version = "0.1.0"
description = "A command-line note manager"
readme = "README.md"
requires-python = ">=3.9"
dependencies = [
    "click>=8.1,<9",
]

[project.scripts]
notemgr = "notemgr.cli:cli"

[tool.setuptools.packages.find]
where = ["src"]
