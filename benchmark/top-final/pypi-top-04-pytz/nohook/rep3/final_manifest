[project]
name = "world-clock"
version = "0.1.0"
description = "Script for working with timezone-aware datetimes across world regions"
requires-python = ">=3.9"
dependencies = [
    "tzdata; sys_platform == 'win32'",
]

[project.optional-dependencies]
dev = ["pytest"]

[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"
