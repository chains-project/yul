name: Build

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7.0.1

      - uses: actions/setup-node@v7.0.0
        with:
          node-version: 22

      - run: npm test

      - run: npm run build

      - uses: actions/upload-artifact@v7.0.1
        with:
          name: build-output
          path: dist/
