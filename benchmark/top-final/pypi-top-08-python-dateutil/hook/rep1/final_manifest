[project]
name = "dateexpr"
version = "0.1.0"
description = "Parse flexible, human-written date strings and compute relative date arithmetic"
readme = "README.md"
authors = [
    { name = "benchmark", email = "amansha@kth.se" }
]
requires-python = ">=3.11"
dependencies = [
    "python-dateutil>=2.9.0.post0",
]

[project.scripts]
dateexpr = "dateexpr:main"

[build-system]
requires = ["uv_build>=0.8.23,<0.9.0"]
build-backend = "uv_build"

[dependency-groups]
dev = [
    "pytest>=9.1.1",
]
