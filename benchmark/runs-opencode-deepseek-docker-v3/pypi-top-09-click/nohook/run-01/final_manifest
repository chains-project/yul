[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "clitool"
version = "0.1.0"
description = "A multi-command command-line tool for managing local tasks and config."
readme = "README.md"
requires-python = ">=3.10"
license = { text = "MIT" }
authors = [{ name = "clitool contributors" }]
keywords = ["cli", "argparse", "command-line"]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Environment :: Console",
    "Intended Audience :: Developers",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3 :: Only",
    "Topic :: Software Development :: Libraries :: Python Modules",
]
dependencies = []

[project.optional-dependencies]
dev = [
    "pytest>=8.0",
    "ruff>=0.5",
]

[project.scripts]
clitool = "clitool.cli:main"

[project.urls]
Homepage = "https://example.com/clitool"
Issues = "https://example.com/clitool/issues"

[tool.hatch.build.targets.wheel]
packages = ["src/clitool"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q"

[tool.ruff]
line-length = 88
target-version = "py310"
src = ["src", "tests"]

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B"]
