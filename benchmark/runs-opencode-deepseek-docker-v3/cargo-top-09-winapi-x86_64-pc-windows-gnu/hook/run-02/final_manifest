[package]
name = "windows-gnu-cross"
version = "0.1.0"
edition = "2021"
description = "Example project cross-compiled to x86_64-pc-windows-gnu using the Windows API."

[dependencies]
winapi = { version = "0.3.9", features = ["winuser", "winnt", "windef", "minwindef"] }

# Raw Windows API bindings are provided by `winapi`, but linking them on the
# GNU target requires the platform-specific import libraries. `winapi` already
# pulls this crate in for x86_64-pc-windows-gnu; declaring it here makes the
# requirement explicit and pins its version.
[target.x86_64-pc-windows-gnu.dependencies]
winapi-x86_64-pc-windows-gnu = "0.4.0"
