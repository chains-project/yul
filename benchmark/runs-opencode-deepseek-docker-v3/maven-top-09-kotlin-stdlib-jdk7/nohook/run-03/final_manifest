<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>kotlin-jdk7</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>kotlin-jdk7</name>
    <description>Maven-built Kotlin project using the JDK 7-compatible Kotlin standard library.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
          Kotlin has no "1.7" JVM target: class-file version 51 is never emitted.
          It emits either 1.6 (version 50) or 1.8 (version 52). Only 1.6 bytecode
          actually runs on a JDK 7 runtime, and the last Kotlin release that can
          emit it is 1.6.21. The "jdk7" profile below selects exactly that setup;
          it must be built with a JDK 8 toolchain (the 1.6.21 compiler cannot run
          on JDK 26). The default values keep the project buildable on this
          machine's JDK 26 using the minimum target modern Kotlin still supports.
        -->
        <kotlin.version>2.4.20</kotlin.version>
        <kotlin.jvmTarget>1.8</kotlin.jvmTarget>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
    </properties>

    <dependencies>
        <!--
          kotlin-stdlib-jdk7 is Kotlin's standard library with the JDK 7
          compatibility extensions (e.g. AutoCloseable.use, java.nio.file
          helpers). On Kotlin 1.8+ these APIs were folded into kotlin-stdlib,
          so this artifact is a thin shim; under the "jdk7" profile it resolves
          to the real JDK 7 build of the library.
        -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib-jdk7</artifactId>
            <version>${kotlin.version}</version>
        </dependency>

        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit</artifactId>
            <version>${kotlin.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <testSourceDirectory>src/test/kotlin</testSourceDirectory>

        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <jvmTarget>${kotlin.jvmTarget}</jvmTarget>
                    <javaParameters>true</javaParameters>
                </configuration>
            </plugin>

            <!--
              All sources are Kotlin, so don't invoke javac. This also avoids
              javac rejecting -source/-target 1.7 on modern JDKs.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <skipMain>true</skipMain>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>jdk7</id>
            <properties>
                <kotlin.version>1.6.21</kotlin.version>
                <kotlin.jvmTarget>1.6</kotlin.jvmTarget>
                <maven.compiler.source>1.7</maven.compiler.source>
                <maven.compiler.target>1.7</maven.compiler.target>
            </properties>
        </profile>
    </profiles>
</project>
