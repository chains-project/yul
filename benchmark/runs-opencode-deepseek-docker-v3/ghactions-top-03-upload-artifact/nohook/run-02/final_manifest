name: Build

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Build
        run: |
          set -euo pipefail
          rm -rf dist
          mkdir -p dist/plugins
          node --check .opencode/plugins/yul-auth-guard.js
          cp opencode.json dist/opencode.json
          cp .opencode/plugins/yul-auth-guard.js dist/plugins/
          echo "Built on $(date -u +%Y-%m-%dT%H:%M:%SZ) from ${GITHUB_SHA}" > dist/BUILD_INFO.txt

      - name: Upload build output
        uses: actions/upload-artifact@v4
        with:
          name: build-output
          path: dist/
          if-no-files-found: error
          retention-days: 14
