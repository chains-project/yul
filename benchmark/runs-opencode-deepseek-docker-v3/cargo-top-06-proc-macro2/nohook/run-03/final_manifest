[package]
name = "token_wrapper"
version = "0.1.0"
edition = "2024"
description = "Procedural macros built on a stable, compiler-independent token-stream wrapper"
license = "MIT OR Apache-2.0"

[lib]
proc-macro = true

[dependencies]
proc-macro2 = "1"
quote = "1"
syn = { version = "2", features = ["full"] }

[dev-dependencies]
proc-macro2 = "1"
