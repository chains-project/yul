{
  "name": "module-resolver",
  "version": "0.1.0",
  "description": "Programmatic implementation of Node's module resolution algorithm for build tools",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "node",
    "module",
    "resolution",
    "require.resolve",
    "build-tool",
    "resolver"
  ],
  "license": "MIT",
  "dependencies": {
    "enhanced-resolve": "^5.26.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
