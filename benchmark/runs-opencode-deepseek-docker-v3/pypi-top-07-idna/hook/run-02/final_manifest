[project]
name = "idna-tool"
version = "0.1.0"
description = "Encode and decode internationalized domain names per the IDNA specification"
requires-python = ">=3.9"
dependencies = [
    "idna>=3.6",
]

[project.scripts]
idna-tool = "idnatool.cli:main"

[project.optional-dependencies]
dev = [
    "pytest>=8.0",
    "ruff>=0.6",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/idnatool"]

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.ruff]
line-length = 100
target-version = "py39"
