[project]
name = "idn-tools"
version = "0.1.0"
description = "Encode and decode internationalized domain names (IDNA 2008 / UTS #46)"
readme = "README.md"
requires-python = ">=3.9"
license = { text = "MIT" }
dependencies = [
    "idna>=3.6",
]

[project.optional-dependencies]
dev = [
    "pytest>=8.0",
]

[project.scripts]
idn = "idn_tools.cli:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/idn_tools"]

[tool.pytest.ini_options]
testpaths = ["tests"]
