              "file": "Cargo.lock",
              "patch": "Index: Cargo.lock\n===================================================================\n--- Cargo.lock\t\n+++ Cargo.lock\t\n@@ -0,0 +1,7 @@\n+# This file is automatically @generated by Cargo.\n+# It is not intended for manual editing.\n+version = 4\n+\n+[[package]]\n+name = \"runtime-static\"\n+version = \"0.1.0\"\n",
              "additions": 7,
              "deletions": 0,
              "status": "added"
            },
            {
              "file": "Cargo.toml",
              "patch": "Index: Cargo.toml\n===================================================================\n--- Cargo.toml\t\n+++ Cargo.toml\t\n@@ -0,0 +1,6 @@\n+[package]\n+name = \"runtime-static\"\n+version = \"0.1.0\"\n+edition = \"2024\"\n+\n+[dependencies]\n",
              "additions": 6,
              "deletions": 0,
              "status": "added"
            },
            {
              "file": "src/main.rs",
              "patch": "Index: src/main.rs\n===================================================================\n--- src/main.rs\t\n+++ src/main.rs\t\n@@ -0,0 +1,38 @@\n+use std::collections::HashSet;\n+use std::sync::LazyLock;\n+\n+const LIMIT: u32 = 100;\n+\n+static PRIMES: LazyLock<HashSet<u32>> = LazyLock::new(|| {\n+    let mut sieve = vec![true; (LIMIT + 1) as usize];\n+    sieve[0] = false;\n+    sieve[1] = false;\n+\n+    let mut n = 2;\n+    while n * n <= LIMIT {\n+        if sieve[n as usize] {\n+            let mut multiple = n * n;\n+            while multiple <= LIMIT {\n+                sieve[multiple as usize] = false;\n+                multiple += n;\n+            }\n+        }\n+        n += 1;\n+    }\n+\n+    sieve\n+        .into_iter()\n+        .enumerate()\n+        .filter_map(|(value, is_prime)| is_prime.then_some(value as u32))\n+        .collect()\n+});\n+\n+fn main() {\n+    for n in 2..=20 {\n+        if PRIMES.contains(&n) {\n+            println!(\"{n} is prime\");\n+        }\n+    }\n+\n+    println!(\"computed {} primes up to {LIMIT}\", PRIMES.len());\n+}\n",
              "additions": 38,
              "deletions": 0,
              "status": "added"
            }
          ]
