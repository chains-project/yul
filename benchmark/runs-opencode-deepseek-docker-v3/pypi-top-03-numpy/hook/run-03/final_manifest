[project]
name = "numcompute"
version = "0.1.0"
description = "Numerical array and matrix computation toolkit"
readme = "README.md"
authors = [
    { name = "benchmark", email = "benchmark@example.com" }
]
requires-python = ">=3.13"
dependencies = [
    "numpy>=2.5.3",
    "scipy>=1.18.1",
]

[project.scripts]
numcompute = "numcompute.__main__:main"

[project.optional-dependencies]
# Optional JIT / GPU acceleration for the hottest kernels.
accel = [
    "numba>=0.62",
]

[build-system]
requires = ["uv_build>=0.12.23,<0.13.0"]
build-backend = "uv_build"

[dependency-groups]
dev = [
    "mypy>=2.4.0",
    "pytest>=9.1.1",
    "pytest-cov>=7.1.0",
    "ruff>=0.16.10",
    "scipy-stubs>=1.18.1.1",
]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-ra --cov=numcompute --cov-report=term-missing"

[tool.ruff]
line-length = 88
target-version = "py313"

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "NPY", "RUF"]

[tool.mypy]
python_version = "3.13"
strict = true
files = ["src", "tests"]
