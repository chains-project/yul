[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "worldtime"
version = "0.1.0"
description = "Timezone-aware datetime helpers for working across world regions"
requires-python = ">=3.9"
dependencies = [
    "tzdata>=2024.1; platform_system == 'Windows'",
]

[project.optional-dependencies]
dev = ["pytest>=8.0"]

[project.scripts]
worldtime = "worldtime.cli:main"

[tool.hatch.build.targets.wheel]
packages = ["src/worldtime"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q"
