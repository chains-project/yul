[package]
name = "platform_kit"
version = "0.1.0"
edition = "2024"
rust-version = "1.85"
description = "Dependency-free cross-platform primitives with a single home for cfg attributes."
license = "MIT OR Apache-2.0"
keywords = ["cross-platform", "cfg", "portable"]
