[package]
name = "crossplat"
version = "0.1.0"
edition = "2024"
rust-version = "1.85"
description = "A library with clean, readable conditional compilation across target platforms."
license = "MIT OR Apache-2.0"
repository = "https://github.com/example/crossplat"

[dependencies]
cfg-if = "1"

# Target-specific dependencies are declared per platform so they are only
# compiled (and resolved) on the platforms that actually need them.
[target.'cfg(unix)'.dependencies]
libc = "0.2"

[lints.rust]
unsafe_code = "deny"
missing_docs = "warn"

[lints.clippy]
all = "warn"
pedantic = "warn"
