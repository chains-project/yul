{
  "name": "macos-watch",
  "version": "0.1.0",
  "description": "macOS file-watching tool built on native FSEvents notifications",
  "private": true,
  "type": "module",
  "bin": {
    "macos-watch": "src/cli.js"
  },
  "exports": {
    ".": "./src/watcher.js"
  },
