{
  "name": "fswatch-native",
  "version": "0.1.0",
  "description": "macOS file watcher backed by the native FSEvents API",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "fswatch-native": "./bin/fswatch.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/fswatch.js",
    "smoke": "node --input-type=module -e \"import('./src/index.js').then(m => console.log(typeof m.watch))\""
  },
  "optionalDependencies": {
    "fsevents": "^2.3.3"
  },
  "keywords": [
    "fsevents",
    "macos",
    "file-watcher",
    "watch"
  ],
  "license": "MIT"
}
