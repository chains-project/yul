[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "https-verify"
version = "0.1.0"
description = "HTTPS client that verifies TLS connections against certifi's up-to-date root CA bundle"
requires-python = ">=3.9"
dependencies = [
    "certifi>=2024.8.30",
]

[project.scripts]
https-verify = "https_verify.__main__:main"

[dependency-groups]
dev = [
    "pytest>=8.0",
]
