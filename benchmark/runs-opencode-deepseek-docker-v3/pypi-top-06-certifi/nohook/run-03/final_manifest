[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "certcheck"
version = "0.1.0"
description = "Verify HTTPS connections using an up-to-date root CA bundle"
requires-python = ">=3.9"
license = { text = "MIT" }
dependencies = [
    "certifi>=2024.7.4",
]

[project.optional-dependencies]
test = ["pytest>=7"]

[project.scripts]
certcheck = "certcheck.__main__:main"

[tool.setuptools.packages.find]
where = ["src"]

[tool.pytest.ini_options]
testpaths = ["tests"]
