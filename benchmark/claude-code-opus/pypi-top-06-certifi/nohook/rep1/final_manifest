[project]
name = "secure-fetch"
version = "0.1.0"
description = "Script that makes HTTPS requests verified against the Mozilla root CA bundle (certifi)."
readme = "README.md"
requires-python = ">=3.10"
dependencies = [
    # Mozilla's curated root CA bundle, re-released frequently.
    # Keep this current: `uv lock --upgrade-package certifi`.
    "certifi>=2025.1.31",
]

[project.scripts]
secure-fetch = "secure_fetch.main:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"
