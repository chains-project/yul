name: Build and consume artifact

on:
  push:
  pull_request:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      # Replace with your real build step.
      - name: Build
        run: |
          mkdir -p dist
          echo "Built from ${GITHUB_SHA} at $(date -u +%FT%TZ)" > dist/build-info.txt

      - name: Upload build output
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: build-output
          path: dist/
          if-no-files-found: error
          retention-days: 7

  consume:
    # `needs` makes this job wait for `build` to finish successfully,
    # so the artifact is guaranteed to exist when we download it.
    needs: build
    runs-on: ubuntu-latest
    steps:
      - name: Download build output
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: build-output
          path: dist/

      - name: Use the artifact
        run: |
          ls -la dist/
          cat dist/build-info.txt
