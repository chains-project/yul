name: Build and use artifact

on:
  push:
  pull_request:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Produce build output
        run: |
          mkdir -p dist
          echo "Built from ${GITHUB_SHA} at $(date -u +%Y-%m-%dT%H:%M:%SZ)" > dist/build-info.txt
          echo "hello from the build job" > dist/output.txt

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: build-output
          path: dist/
          if-no-files-found: error
          retention-days: 1

  consume:
    runs-on: ubuntu-latest
    # `needs` makes this job wait for `build` to finish successfully,
    # which guarantees the artifact exists before we try to download it.
    needs: build
    steps:
      - name: Download artifact
        uses: actions/download-artifact@v4
        with:
          name: build-output
          path: dist/

      - name: Use artifact
        run: |
          ls -la dist/
          cat dist/build-info.txt
          cat dist/output.txt
