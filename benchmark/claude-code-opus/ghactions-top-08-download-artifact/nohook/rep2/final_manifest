name: Build and consume artifact

on:
  push:
    branches: [main, master]
  pull_request:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Produce build output
        run: |
          mkdir -p dist
          echo "Built from ${GITHUB_SHA} in run ${GITHUB_RUN_ID}" > dist/build-info.txt
          date -u +"%Y-%m-%dT%H:%M:%SZ" > dist/built-at.txt

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: build-output
          path: dist/
          if-no-files-found: error
          retention-days: 7

  consume:
    runs-on: ubuntu-latest
    # Waits for `build` to finish successfully before starting.
    needs: build
    steps:
      - name: Download artifact
        uses: actions/download-artifact@v4
        with:
          # Must match the name used in upload-artifact.
          name: build-output
          path: dist/

      - name: Use artifact
        run: |
          ls -la dist/
          cat dist/build-info.txt
          cat dist/built-at.txt
