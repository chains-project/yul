name: Build and consume artifact

on:
  push:
  pull_request:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Produce build output
        run: |
          mkdir -p dist
          echo "Built from ${GITHUB_SHA} at $(date -u +%FT%TZ)" > dist/build-info.txt
          echo "hello from the build job" > dist/app.txt

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: build-output
          path: dist/
          if-no-files-found: error
          retention-days: 7

  consume:
    runs-on: ubuntu-latest
    # Wait for build to finish; without this the jobs run in parallel
    # and the artifact won't exist yet.
    needs: build
    steps:
      - name: Download artifact
        uses: actions/download-artifact@v4
        with:
          name: build-output
          path: dist/

      - name: Use artifact
        run: |
          ls -la dist/
          cat dist/build-info.txt
          cat dist/app.txt
