[project]
name = "worldtime"
version = "0.1.0"
description = "Timezone-aware datetime utilities for working across world regions"
readme = "README.md"
requires-python = ">=3.9"
dependencies = [
    # IANA tz database for zoneinfo; required on Windows and minimal
    # containers that lack /usr/share/zoneinfo, and keeps rules up to date.
    "tzdata>=2024.1",
]

[project.scripts]
worldtime = "worldtime.cli:main"

[dependency-groups]
dev = ["pytest>=8"]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.pytest.ini_options]
testpaths = ["tests"]
