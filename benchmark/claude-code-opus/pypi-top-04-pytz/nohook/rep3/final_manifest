[project]
name = "worldtime"
version = "0.1.0"
description = "Timezone-aware datetime helpers and a world-clock CLI"
readme = "README.md"
authors = [
    { name = "benchmark", email = "benchmark@example.com" }
]
requires-python = ">=3.13"
dependencies = [
    "tzdata>=2026.4",
]

[project.scripts]
worldtime = "worldtime:main"

[build-system]
requires = ["uv_build>=0.12.22,<0.13.0"]
build-backend = "uv_build"

[dependency-groups]
dev = [
    "pytest>=9.1.1",
]
