[project]
name = "worldtime"
version = "0.1.0"
description = "Work with timezone-aware datetimes across world regions"
readme = "README.md"
requires-python = ">=3.11"
dependencies = [
    # IANA tz database as a package; zoneinfo falls back to it when the OS has none
    # (Windows, slim containers). Keep it updated to pick up DST/offset rule changes.
    "tzdata>=2025.2",
]

[project.scripts]
worldtime = "worldtime.cli:main"

[dependency-groups]
dev = ["pytest>=8", "ruff>=0.6"]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.ruff]
line-length = 100

[tool.ruff.lint]
# DTZ flags naive datetime usage (datetime.now() without tz, utcnow(), etc.)
select = ["E", "F", "I", "UP", "B", "DTZ"]

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.ruff.lint.per-file-ignores]
# Tests deliberately build naive wall-clock times to feed into localize()
"tests/**" = ["DTZ001"]
