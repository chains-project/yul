[build-system]
# pip on Python 2 resolves this to setuptools 44.x, the last release supporting 2.7.
# Package metadata lives in setup.cfg because PEP 621 [project] tables are not
# understood by any setuptools release that still runs on Python 2.
requires = ["setuptools>=40.8.0", "wheel"]
build-backend = "setuptools.build_meta"
