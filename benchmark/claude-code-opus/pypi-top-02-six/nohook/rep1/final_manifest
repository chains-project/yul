# Build-system declaration only. Project metadata lives in setup.cfg because
# PEP 621 ([project] tables) requires setuptools >= 61, which cannot run on
# Python 2. setuptools 44.x is the last release that supports Python 2.7.
[build-system]
requires = ["setuptools>=40.8.0", "wheel"]
build-backend = "setuptools.build_meta"
