# Stop Lombok from searching parent directories for more config.
config.stopBubbling = true
# Mark generated code with @lombok.Generated so coverage tools (e.g. JaCoCo) ignore it.
lombok.addLombokGeneratedAnnotation = true
# Make @EqualsAndHashCode / @Data callSuper behaviour an explicit decision on subclasses.
lombok.equalsAndHashCode.callSuper = warn
