[project]
name = "idna-tool"
version = "0.1.0"
description = "Encode and decode internationalized domain names (IDNA 2008 / UTS #46)"
readme = "README.md"
requires-python = ">=3.9"
dependencies = ["idna>=3.7"]

[project.scripts]
idna-tool = "idna_tool.cli:main"

[dependency-groups]
dev = ["pytest>=8"]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.pytest.ini_options]
testpaths = ["tests"]
