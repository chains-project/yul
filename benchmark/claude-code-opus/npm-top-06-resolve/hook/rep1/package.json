{
  "name": "node-module-resolver",
  "version": "0.1.0",
  "description": "A programmatic implementation of Node.js's CommonJS module resolution algorithm (require.resolve), including package \"exports\" and \"imports\".",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "resolve",
    "require.resolve",
    "module-resolution",
    "build-tool"
  ],
  "license": "MIT"
}
