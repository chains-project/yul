{
  "name": "node-module-resolver",
  "version": "0.1.0",
  "description": "A programmatic, spec-faithful implementation of Node's CommonJS module resolution algorithm (require.resolve) for build tools",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:watch": "node --test --watch \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "resolve",
    "require.resolve",
    "module-resolution",
    "exports",
    "imports",
    "build-tool"
  ],
  "license": "MIT"
}
