[project]
name = "httptool"
version = "0.1.0"
description = "Script with low-level HTTP connection control: pooling, retries, timeouts."
readme = "README.md"
requires-python = ">=3.10"
dependencies = [
    "urllib3>=2.2,<3",
]

[project.scripts]
httptool = "httptool.cli:main"

[dependency-groups]
dev = [
    "pytest>=8",
    "pytest-httpserver>=1.0",
    "ruff>=0.6",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.ruff]
line-length = 100
target-version = "py310"

[tool.pytest.ini_options]
testpaths = ["tests"]
