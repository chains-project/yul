[package]
name = "wintool"
version = "0.1.0"
edition = "2024"
description = "Windows-only tool using raw Win32 API bindings"
publish = false

# Raw, zero-overhead FFI bindings to the Win32 API. Enable additional
# `Win32_*` features as you need more of the API surface; each feature
# corresponds to a module under `windows_sys::Win32`.
[target.'cfg(windows)'.dependencies]
windows-sys = { version = "0.61.2", features = [
    "Win32_Foundation",
    "Win32_System_Threading",
    "Win32_UI_WindowsAndMessaging",
] }

[profile.release]
lto = true
codegen-units = 1
strip = true
