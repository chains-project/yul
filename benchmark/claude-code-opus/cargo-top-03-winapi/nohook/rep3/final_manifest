[package]
name = "win-tool"
version = "0.1.0"
edition = "2024"
description = "Windows-only command-line tool"
publish = false

# Windows API bindings. `windows-sys` gives raw, zero-overhead FFI declarations
# generated from Microsoft's metadata. Enable additional `Win32_*` features as
# you need more of the API surface (see https://microsoft.github.io/windows-rs/features).
[target.'cfg(windows)'.dependencies]
windows-sys = { version = "0.61.2", features = [
    "Win32_Foundation",
    "Win32_System_Threading",
    "Win32_UI_WindowsAndMessaging",
] }

[profile.release]
lto = true
codegen-units = 1
strip = true
