name: Java CI

on:
  push:
    branches: [main, master]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

env:
  # Change these to select the JDK. Supported distributions include:
  # temurin, zulu, corretto, liberica, microsoft, oracle, semeru, graalvm
  JAVA_DISTRIBUTION: temurin
  JAVA_VERSION: '21'

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Check out repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - name: Detect build tool
        id: detect
        run: |
          if [ -f pom.xml ]; then
            echo "tool=maven" >> "$GITHUB_OUTPUT"
          elif [ -f gradlew ] || [ -f build.gradle ] || [ -f build.gradle.kts ]; then
            echo "tool=gradle" >> "$GITHUB_OUTPUT"
          else
            echo "::error::No pom.xml or Gradle build file found"
            exit 1
          fi

      - name: Set up JDK ${{ env.JAVA_VERSION }} (${{ env.JAVA_DISTRIBUTION }})
        uses: actions/setup-java@de7274f081f381c8f8158605e0321c36c376e2e6 # v6.0.1
        with:
          distribution: ${{ env.JAVA_DISTRIBUTION }}
          java-version: ${{ env.JAVA_VERSION }}
          cache: ${{ steps.detect.outputs.tool }}

      - name: Verify Java installation
        run: |
          java -version
          echo "JAVA_HOME=$JAVA_HOME"

      - name: Build with Maven
        if: steps.detect.outputs.tool == 'maven'
        run: |
          if [ -f mvnw ]; then
            chmod +x mvnw
            ./mvnw -B verify
          else
            mvn -B verify
          fi

      - name: Set up Gradle
        if: steps.detect.outputs.tool == 'gradle'
        uses: gradle/actions/setup-gradle@3f5f9adaf7d9fecd50b5935e54106014257a94e6 # v6.4.0

      - name: Build with Gradle
        if: steps.detect.outputs.tool == 'gradle'
        run: |
          if [ -f gradlew ]; then
            chmod +x gradlew
            ./gradlew build
          else
            gradle build
          fi
