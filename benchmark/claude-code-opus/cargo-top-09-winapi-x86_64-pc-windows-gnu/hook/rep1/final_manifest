[package]
name = "win_app"
version = "0.1.0"
edition = "2024"

# Types, constants and the `w!` macro. Since 0.61, windows-sys's own function
# declarations link via windows-link (raw-dylib) and ship no import libraries.
[dependencies.windows-sys]
version = "0.61.2"
features = [
    "Win32_Foundation",
    "Win32_UI_WindowsAndMessaging",
]

# Function imports via `windows_targets::link!`, which links against the
# prebuilt `windows.0.53.0` import library from windows_x86_64_gnu.
[dependencies]
windows-targets = "0.53.5"
