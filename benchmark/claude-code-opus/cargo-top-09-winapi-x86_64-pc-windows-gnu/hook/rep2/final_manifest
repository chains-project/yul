[package]
name = "win-app"
version = "0.1.0"
edition = "2024"

[dependencies]
# Types and constants for the Windows API.
windows-sys = { version = "0.61.2", features = ["Win32_Foundation", "Win32_System_Threading", "Win32_UI_WindowsAndMessaging"] }
# Function imports. On x86_64-pc-windows-gnu this pulls in `windows_x86_64_gnu`,
# which ships the prebuilt import library (libwindows.0.53.0.a) used at link time.
windows-targets = "0.53.5"
