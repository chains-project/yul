[package]
name = "my_macros"
version = "0.1.0"
edition = "2024"

[lib]
proc-macro = true

[dependencies]
proc-macro2 = "1.0.107"
quote = "1.0.47"
# "full" parses all Rust syntax (fn bodies, statements, expressions), not just
# the subset needed for derives. "visit-mut" enables in-place AST rewriting.
syn = { version = "3.0.6", features = ["full", "visit-mut"] }

[dev-dependencies]
# Enables Debug/PartialEq on syntax tree nodes; handy for asserting in tests.
syn = { version = "3.0.6", features = ["full", "visit-mut", "extra-traits"] }
