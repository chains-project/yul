name: CI

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        node-version: [22, 24]

    steps:
      - uses: actions/checkout@v7

      # Restores and saves the npm download cache (~/.npm). The cache key is
      # derived from the hash of package-lock.json, so it is reused until the
      # lockfile changes, at which point a fresh cache is built and saved.
      - name: Set up Node.js ${{ matrix.node-version }}
        id: setup-node
        uses: actions/setup-node@v7
        with:
          node-version: ${{ matrix.node-version }}
          cache: npm
          cache-dependency-path: package-lock.json

      - name: Report cache status
        run: 'echo "npm cache hit: ${{ steps.setup-node.outputs.cache-hit }}"'

      # With a warm cache, npm ci resolves every tarball from ~/.npm instead of
      # downloading from the registry. --prefer-offline skips revalidation.
      - name: Install dependencies
        run: npm ci --prefer-offline --no-audit --no-fund

      - name: Lint
        run: npm run lint

      - name: Test
        run: npm test
