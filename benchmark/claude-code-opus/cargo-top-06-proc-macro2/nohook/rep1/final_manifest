[package]
name = "my_macros"
version = "0.1.0"
edition = "2024"

[lib]
proc-macro = true

[dependencies]
# Stable wrapper around the compiler's `proc_macro` API. Unlike `proc_macro`,
# its types work outside of a macro invocation (unit tests, build scripts, etc.).
proc-macro2 = "1.0.107"
quote = "1.0.47"
syn = { version = "3.0.6", features = ["full"] }
