{
  "name": "node-resolve",
  "version": "1.0.0",
  "description": "A build tool that implements Node.js module resolution algorithm programmatically",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepare": "npm run build"
  },
  "keywords": [
    "module-resolution",
    "node.js",
    "require.resolve",
    "build-tool"
  ],
  "license": "MIT"
}