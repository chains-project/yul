[build-system]
requires = ["setuptools>=68.0", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "cli-tool"
version = "0.1.0"
description = "A command-line tool with multiple subcommands"
requires-python = ">=3.9"
dependencies = [
    "click>=8.1.0",
]

[project.scripts]
cli-tool = "cli_tool.cli:cli"

[tool.setuptools.packages.find]
where = ["src"]

[tool.pytest.ini_options]
testpaths = ["tests"]