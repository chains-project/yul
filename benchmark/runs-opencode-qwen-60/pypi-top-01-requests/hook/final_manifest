[build-system]
requires = ["setuptools>=68.0", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "api-fetcher"
version = "0.1.0"
description = "A script that fetches data from a REST API over HTTP"
requires-python = ">=3.9"
dependencies = [
    "requests>=2.31",
]

[project.scripts]
api-fetcher = "api_fetcher.__main__:main"

[tool.setuptools.packages.find]
where = ["src"]