name: Release
on:
  push:
    tags:
      - 'v*'
jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Build binary
        run: go build -o myapp .
      - name: Publish release
        uses: softprops/action-gh-release@v2
        with:
          files: myapp