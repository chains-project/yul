[build-system]
requires = ["setuptools>=68.0", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "worldtime"
version = "0.1.0"
description = "Work with timezone-aware datetimes across different regions"
requires-python = ">=3.9"
dependencies = [
    "pytz>=2024.1",
]

[project.scripts]
worldtime = "main:main"

[tool.setuptools.packages.find]
where = ["."]
include = ["worldtime*"]