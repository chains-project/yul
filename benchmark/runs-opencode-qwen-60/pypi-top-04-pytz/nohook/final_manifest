[build-system]
requires = ["setuptools>=68.0", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "timezone-tools"
version = "0.1.0"
description = "Utilities for timezone-aware datetimes across different regions"
requires-python = ">=3.6"
dependencies = [
    "pytz>=2024.1",
]

[project.optional-dependencies]
dev = [
    "pytest>=7.0",
]

[tool.setuptools.packages.find]
where = ["src"]