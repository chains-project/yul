[build-system]
requires = ["setuptools>=61.0"]
build-backend = "setuptools.build_meta"

[project]
name = "http-client"
version = "0.1.0"
description = "Low-level HTTP client with connection pooling and automatic retries"
readme = "README.md"
requires-python = ">=3.6"
dependencies = [
    "urllib3>=1.26,<3",
]

[project.scripts]
http-client = "http_client:main"

[tool.setuptools]
py-modules = ["http_client"]
