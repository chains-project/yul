[build-system]
requires = ["setuptools>=61.0"]
build-backend = "setuptools.build_meta"

[project]
name = "api-fetch"
version = "0.1.0"
description = "Fetch data from a REST API over HTTP"
readme = "README.md"
requires-python = ">=3.8"
dependencies = [
    "requests>=2.28",
]

[project.optional-dependencies]
dev = [
    "pytest>=7.0",
]

[project.scripts]
api-fetch = "api_fetch.__main__:main"

[tool.setuptools.packages.find]
where = ["src"]
