[build-system]
requires = ["setuptools>=61.0"]
build-backend = "setuptools.build_meta"

[project]
name = "rest-fetcher"
version = "0.1.0"
description = "A script that fetches data from a REST API over HTTP"
readme = "README.md"
requires-python = ">=3.8"
dependencies = [
    "requests>=2.28",
]

[project.optional-dependencies]
dev = [
    "pytest>=7.0",
]

[project.scripts]
rest-fetcher = "rest_fetcher.cli:main"

[tool.setuptools.packages.find]
where = ["src"]
