[build-system]
requires = ["setuptools>=42", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "rest-fetcher"
version = "0.1.0"
description = "A small script that fetches data from a REST API over HTTP."
requires-python = ">=3.6"
license = { text = "MIT" }
dependencies = [
    "requests>=2.20",
]

[project.optional-dependencies]
dev = [
    "pytest>=6.0",
    "responses>=0.12",
]

[project.scripts]
rest-fetcher = "rest_fetcher.__main__:main"

[tool.setuptools.packages.find]
where = ["src"]
