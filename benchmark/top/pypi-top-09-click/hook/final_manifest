[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "taskcli"
version = "0.1.0"
description = "A command-line task manager built with Click"
readme = "README.md"
requires-python = ">=3.9"
dependencies = [
    "click==8.5.0",
]

[project.scripts]
taskcli = "taskcli.cli:cli"

[tool.setuptools.packages.find]
where = ["src"]
