<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>kotlin-jdk7-app</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>kotlin-jdk7-app</name>
    <description>Kotlin/JVM project built with Maven, targeting JDK 7</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Kotlin has no 1.7 jvm-target (valid values are 1.6 and 1.8+, and
             pre-1.8 emission was removed in Kotlin 1.7.0 - KT-45165), so 1.6
             is the bytecode floor that still runs on a JDK 7 JVM. The
             JDK 7-only APIs come from kotlin-stdlib-jdk7 below. -->
        <kotlin.compiler.jvmTarget>1.6</kotlin.compiler.jvmTarget>
        <maven.compiler.source>1.7</maven.compiler.source>
        <maven.compiler.target>1.7</maven.compiler.target>
    </properties>

    <dependencies>
        <!-- Kotlin standard library with JDK 7 compatibility support:
             the java.nio.file / AutoCloseable-based extensions. -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib-jdk7</artifactId>
            <version>${kotlin.version}</version>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>

        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <jvmTarget>${kotlin.compiler.jvmTarget}</jvmTarget>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Last Kotlin release that can emit bytecode runnable on JDK 7.
             Kotlin 1.7.0 removed the pre-1.8 jvm-target (KT-45165) and
             Kotlin 2.x refuses < 1.8 outright. The property is declared in
             a profile (rather than top-level <properties>) so the build
             stays on the JDK 7-compatible toolchain the project requires. -->
        <profile>
            <id>kotlin-jdk7</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <kotlin.version>1.6.21</kotlin.version>
            </properties>
        </profile>
    </profiles>
</project>
