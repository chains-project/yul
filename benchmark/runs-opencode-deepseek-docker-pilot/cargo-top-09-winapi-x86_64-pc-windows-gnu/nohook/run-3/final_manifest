[package]
name = "win-api-demo"
version = "0.1.0"
edition = "2024"
rust-version = "1.85"
description = "Example calling the Windows API, cross-compiled for x86_64-pc-windows-gnu"

[dependencies]
winapi = { version = "0.3", features = ["winuser"] }

# Platform-specific import libraries for the Windows API bindings.
#
# `winapi` pulls these in automatically for GNU targets, but they are declared
# explicitly so cross-compilation to the 64-bit Windows GNU toolchain is
# self-documenting and guaranteed to link.
[target.x86_64-pc-windows-gnu.dependencies]
winapi-x86_64-pc-windows-gnu = "0.4"
