[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "flexdates"
version = "0.1.0"
description = "Parse flexible human-written date strings and compute relative date arithmetic."
requires-python = ">=3.9"
dependencies = [
    "dateparser>=1.2",
    "python-dateutil>=2.9",
]

[project.optional-dependencies]
dev = [
    "pytest>=8.0",
]

[tool.setuptools.packages.find]
where = ["src"]

[tool.pytest.ini_options]
testpaths = ["tests"]
