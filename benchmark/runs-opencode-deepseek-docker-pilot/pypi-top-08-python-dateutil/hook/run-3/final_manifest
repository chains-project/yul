[build-system]
requires = ["setuptools>=68", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "datephrase"
version = "0.1.0"
description = "Parse flexible human-written date strings and compute relative date arithmetic."
requires-python = ">=3.9"
dependencies = [
    "python-dateutil>=2.8",
    "dateparser>=1.2",
]

[project.optional-dependencies]
test = ["pytest>=7"]

[project.scripts]
datephrase = "datephrase.__main__:main"

[tool.setuptools.packages.find]
where = ["src"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q"
