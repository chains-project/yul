[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "idn-tool"
version = "0.1.0"
description = "Encode and decode internationalized domain names per the IDNA specification."
requires-python = ">=3.9"
license = { text = "MIT" }
dependencies = [
    "idna>=3.6",
]

[project.optional-dependencies]
dev = [
    "pytest>=7.4",
]

[project.scripts]
idn-tool = "idn_tool.cli:main"

[tool.hatch.build.targets.wheel]
packages = ["src/idn_tool"]

[tool.pytest.ini_options]
testpaths = ["tests"]
