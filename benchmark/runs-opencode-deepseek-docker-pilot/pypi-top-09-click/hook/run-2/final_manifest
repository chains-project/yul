[build-system]
requires = ["setuptools>=61"]
build-backend = "setuptools.build_meta"

[project]
name = "clitool"
description = "A small example command-line task tracker built on argparse."
readme = "README.md"
requires-python = ">=3.9"
license = { text = "MIT" }
authors = [{ name = "Your Name", email = "you@example.com" }]
keywords = ["cli", "argparse", "tasks"]
classifiers = [
  "Environment :: Console",
  "Programming Language :: Python :: 3",
]
dynamic = ["version"]
dependencies = []

[project.optional-dependencies]
dev = ["pytest>=7", "build"]

[project.scripts]
clitool = "clitool.cli:main"

[project.urls]
Homepage = "https://example.com/clitool"

[tool.setuptools.dynamic]
version = { attr = "clitool.__version__" }

[tool.setuptools.packages.find]
where = ["src"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q"
