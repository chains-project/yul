[package]
name = "xplat"
version = "0.1.0"
edition = "2021"
rust-version = "1.80"
description = "Cross-platform library scaffold with centralized, readable conditional compilation."
license = "MIT OR Apache-2.0"
keywords = ["cross-platform", "portability", "cfg", "no-std"]
categories = ["development-tools", "no-std"]

[lib]
path = "src/lib.rs"

[features]
default = ["std"]
std = []

[dependencies]
cfg-if = "1.0"

[build-dependencies]
cfg_aliases = "0.2"

# --- Platform-specific dependencies ---------------------------------------
# NOTE: Cargo evaluates manifests *before* build scripts run, so the semantic
# aliases from `build.rs` (e.g. `unix_family`) are not visible here. Use
# Cargo's built-in `cfg(...)` predicates in this section only.
[target.'cfg(unix)'.dependencies]
libc = { version = "0.2", default-features = false }

[target.'cfg(windows)'.dependencies]
windows-sys = { version = "0.59", features = ["Win32_System_SystemInformation"] }
