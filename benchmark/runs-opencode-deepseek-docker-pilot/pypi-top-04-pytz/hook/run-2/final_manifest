[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "worldclock"
version = "0.1.0"
description = "Timezone-aware datetime helpers for working across world regions"
requires-python = ">=3.9"
dependencies = []

[project.scripts]
worldclock = "worldclock.__main__:main"

[tool.setuptools.packages.find]
where = ["src"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q"
