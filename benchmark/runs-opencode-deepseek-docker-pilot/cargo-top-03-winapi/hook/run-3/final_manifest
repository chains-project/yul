[package]
name = "win-tool"
version = "0.1.0"
edition = "2021"
description = "Windows-only tool with direct Windows API bindings"
license = "MIT OR Apache-2.0"

[dependencies]

[target.'cfg(windows)'.dependencies]
windows-sys = { version = "0.59", features = [
    "Win32_Foundation",
    "Win32_System_Threading",
    "Win32_UI_WindowsAndMessaging",
] }

[profile.release]
lto = true
codegen-units = 1
strip = true
