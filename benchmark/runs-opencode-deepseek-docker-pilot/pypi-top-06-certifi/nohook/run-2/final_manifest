[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "https-verify"
version = "0.1.0"
description = "Fetch HTTPS resources using an up-to-date, curated root CA bundle."
requires-python = ">=3.9"
dependencies = [
    "certifi>=2024.7.4",
]

[project.optional-dependencies]
dev = [
    "pytest>=8",
]

[project.scripts]
https-verify = "https_verify.__main__:main"

[tool.setuptools.packages.find]
where = ["src"]

[tool.pytest.ini_options]
testpaths = ["tests"]
