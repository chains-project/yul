[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "api-fetcher"
version = "0.1.0"
description = "Fetch data from a REST API over HTTP"
readme = "README.md"
requires-python = ">=3.9"
license = { text = "MIT" }
dependencies = [
    "requests>=2.31",
]

[project.optional-dependencies]
dev = [
    "pytest>=8.0",
    "responses>=0.25",
]

[project.scripts]
api-fetcher = "api_fetcher.cli:main"

[tool.hatch.build.targets.wheel]
packages = ["src/api_fetcher"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q"

[tool.ruff]
src = ["src", "tests"]
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "I", "UP"]
