[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "netclient"
version = "0.1.0"
description = "Low-level HTTP client with connection pooling and automatic retries"
requires-python = ">=3.9"
license = { text = "MIT" }
dependencies = [
    "urllib3>=2.0,<3",
]

[project.optional-dependencies]
dev = [
    "pytest>=7.4",
    "pytest-httpserver>=1.0",
    "ruff>=0.5",
    "mypy>=1.10",
]

[project.scripts]
netclient = "netclient.__main__:main"

[tool.hatch.build.targets.wheel]
packages = ["src/netclient"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-ra"

[tool.ruff]
line-length = 100
target-version = "py39"

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B"]

[tool.mypy]
python_version = "3.10"
strict = true
files = ["src"]
