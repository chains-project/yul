name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20
          # Caches ~/.npm, keyed on the hash of package-lock.json
          cache: npm

      # `npm ci` installs exactly what the lockfile says, and reuses the cached ~/.npm
      - run: npm ci

      - run: npm test
